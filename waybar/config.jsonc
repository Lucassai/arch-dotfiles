{
  "layer": "top",
  "modules-left": ["wlr/taskbar"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": ["pulseaudio", "network", "clock"],

  "clock": {
    "format": "{:%H:%M %a %d/%m}",
    "interval": 1,
    "max-length": 30,
    "rotate": 0,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "months": "<span color='#aecce6'><b>{}</b></span>",
        "days": "<span color='#aecce6'><b>{}</b></span>",
        "weekdays": "<span color='#df373a'><b>{}</b></span>",
        "today": "<span color='#df373a'><b>{}</b></span>"
      }
    }
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "ᛦ",
      "2": "ᛦ",
      "3": "ᛦ",
      "4": "ᛦ"
    },
    "persistent-workspaces": {
      "HDMI-A-1": [1, 2],
      "DP-1": [3, 4]
    }
  },

  "pulseaudio": {
    "format": "{volume}%",
    "format-bluetooth": "{volume}% {icon}",
    "format-muted": "",
    "format-icons": {
      "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
      "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "phone-muted": "",
      "portable": "",
      "car": "",
      "default": ["", ""]
    },
    "scroll-step": 1,
    "on-click": "pavucontrol",
    "ignored-sinks": ["Easy Effects Sink"]
  },

  "network": {
    "tooltip": true,
    "rotate": 0,
    "tooltip-format-ethernet": " {ifname}\nIP: {ipaddr}\nDown: {bandwidthDownBytes}\nUp: {bandwidthUpBytes}",
    "format-wifi": " {essid} <span foreground='#99ffdd'> {bandwidthDownBytes}</span> <span foreground='#ffcc66'> {bandwidthUpBytes}</span>",
    "tooltip-format-wifi": " {essid}\nIP: {ipaddr}\nDown: {bandwidthDownBytes}\nUp: {bandwidthUpBytes}",
    "format-vpn": " {ifname} <span foreground='#99ffdd'> {bandwidthDownBytes}</span> <span foreground='#ffcc66'> {bandwidthUpBytes}</span>",
    "tooltip-format-vpn": " {ifname}\nIP: {ipaddr}\nDown: {bandwidthDownBytes}\nUp: {bandwidthUpBytes}",
    "format-ethernet-no-ip": " {ifname} (No IP)",
    "tooltip-format-ethernet-no-ip": " {ifname} (No IP)",
    "format-linked": " {ifname} (No IP)",
    "format-disconnected": "󰖪 ",
    "tooltip-format-disconnected": "Disconnected",
    "format-ethernet": "<span foreground='#99ffdd'></span> <span foreground='#ffcc66'></span>",
    "interval": 2
  }
}
